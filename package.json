{
  "name": "hibuddy-monorepo",
  "private": true,
  "version": "0.3.2",
  "description": "HiBuddy — personal AI coworker built on deepseek-harness (dsh). Structure per docs/architecture/system-architecture.md §10 and ADR-003.",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "watch": "pnpm -r run watch",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "profile:sync": "pwsh -NoProfile -File scripts/sync-profile.ps1",
    "smoke": "dsh --profile hibuddy-smoke",
    "dsh": "dsh"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.0"
  }
}
