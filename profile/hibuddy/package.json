{
  "name": "hibuddy-profile",
  "description": "HiBuddy product composition: dsh web surface + HiBuddy bundles (see ADR-003 §5.1)",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@hibuddy/ag-ui-bridge": "workspace:*",
    "@hibuddy/brand": "workspace:*",
    "@hibuddy/coworker": "workspace:*",
    "@hibuddy/resident": "workspace:*",
    "@hibuddy/web-ui": "workspace:*"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@hibuddy/brand",
        "@hibuddy/coworker",
        "@hibuddy/resident",
        "@hibuddy/web-ui",
        "@hibuddy/ag-ui-bridge"
      ]
    }
  }
}
